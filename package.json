{
    "name": "vector-ui-monorepo",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "workspaces": [
        "packages/*",
        "docs"
    ],
    "scripts": {
        "start": "npm run dev -w packages/vector-ui",
        "dev": "npm run dev -w packages/vector-ui",
        "build": "npm run build -w packages/vector-ui",
        "test": "npm run test -w packages/vector-ui",
        "test:watch": "npm run test:watch -w packages/vector-ui",
        "docs:dev": "npm run dev -w docs",
        "docs:build": "npm run build -w docs",
        "docs:preview": "npm run preview -w docs",
        "lint:fast": "npm run lint -w packages/vector-ui",
        "lint:deep": "eslint .",
        "lint": "npm run lint:fast && npm run lint:deep",
        "format:check": "npm run format:check -w packages/vector-ui",
        "format:write": "npm run format:write -w packages/vector-ui"
    },
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "eslint": "^9.20.0",
        "eslint-plugin-astro": "^1.3.1",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "typescript-eslint": "^8.68.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
